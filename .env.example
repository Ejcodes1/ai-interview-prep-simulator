# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Flask ---
FLASK_ENV=development
FLASK_SECRET_KEY=change-me-to-a-random-secret

# Optional: override the SQLite location (defaults to instance/app.db)
# DATABASE_URL=sqlite:///instance/app.db

# --- LLM API (OpenAI) ---
# Used by: Question Generator (WP-04), Answer Evaluator (WP-06),
# and the Speech-to-Text Transcriber via the Whisper API (WP-06).
OPENAI_API_KEY=your-openai-api-key-here
# Optional overrides (defaults: gpt-4o-mini and whisper-1).
# OPENAI_MODEL=gpt-4o-mini
# WHISPER_MODEL=whisper-1

# --- Job Search API (Adzuna) ---
# Used by: Job Search Module (WP-03).
ADZUNA_APP_ID=your-adzuna-app-id-here
ADZUNA_APP_KEY=your-adzuna-app-key-here
# Adzuna country code the search endpoint queries (e.g. us, gb, de, ca).
ADZUNA_COUNTRY=us

# --- Cost control (NFR-07) ---
# Maximum number of LLM API calls allowed per interview session.
MAX_LLM_CALLS_PER_SESSION=20
